const { list, put } = require("@vercel/blob");

const TEMPLATES_PATH = "aivideobox/shared/templates.json";

module.exports = async function handler(req, res) {
  try {
    res.setHeader("Cache-Control", "no-store, max-age=0");

    if (!process.env.BLOB_READ_WRITE_TOKEN) {
      res.status(200).json({ templates: [], disabled: true, message: "Vercel Blob is not configured." });
      return;
    }

    if (req.method === "GET") {
      const data = await readJsonBlob(TEMPLATES_PATH, { templates: [] });
      res.status(200).json({ templates: Array.isArray(data.templates) ? data.templates : [] });
      return;
    }

    if (req.method === "POST") {
      const incoming = Array.isArray(req.body?.templates) ? req.body.templates : [];
      const deletedIds = Array.isArray(req.body?.deletedIds) ? req.body.deletedIds.map((id) => String(id).trim()).filter(Boolean) : [];
      if (!incoming.length && !deletedIds.length) {
        res.status(200).json({ ok: false, skipped: true, message: "Refusing to overwrite shared templates with an empty list." });
        return;
      }
      const current = await readJsonBlob(TEMPLATES_PATH, { templates: [] });
      const merged = mergeTemplates(Array.isArray(current.templates) ? current.templates : [], incoming, deletedIds);
      await writeJsonBlob(TEMPLATES_PATH, { templates: merged, updatedAt: new Date().toISOString() });
      res.status(200).json({ ok: true, templates: merged });
      return;
    }

    res.status(405).json({ error: "Method not allowed" });
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    const status = /suspended|not configured|missing token|unauthorized/i.test(message) ? 200 : 500;
    res.status(status).json({
      error: "Shared templates storage failed",
      disabled: status === 200,
      message,
    });
  }
};

function mergeTemplates(existing = [], incoming = [], deletedIds = []) {
  const byId = new Map();
  const deleted = new Set(deletedIds);
  [...existing, ...incoming].forEach((template) => {
    const id = String(template?.id || "").trim();
    if (!id || deleted.has(id)) return;
    byId.set(id, {
      ...template,
      id,
      updatedAt: template.updatedAt || template.createdAt || new Date().toISOString(),
    });
  });
  return [...byId.values()].sort((a, b) => String(b.updatedAt || "").localeCompare(String(a.updatedAt || "")));
}

async function readJsonBlob(pathname, fallback) {
  const found = await findBlob(pathname);
  if (!found?.url) return fallback;
  const response = await fetch(`${found.url}${found.url.includes("?") ? "&" : "?"}t=${Date.now()}`, {
    cache: "no-store",
  });
  if (!response.ok) return fallback;
  try {
    return await response.json();
  } catch {
    return fallback;
  }
}

async function writeJsonBlob(pathname, value) {
  await put(pathname, JSON.stringify(value), {
    access: "public",
    addRandomSuffix: false,
    allowOverwrite: true,
    contentType: "application/json",
  });
}

async function findBlob(pathname) {
  const result = await list({ prefix: pathname, limit: 10 });
  return result.blobs.find((blob) => blob.pathname === pathname) || null;
}
